# Сборка образа сервиса заказов.
#
# ВНИМАНИЕ: этот файл написан намеренно плохо. Он работает, но образ
# получается примерно на гигабайт больше, чем нужно, приложение запускается
# от имени администратора, а любое изменение одной строчки кода приводит
# к переустановке всех зависимостей заново.

FROM python:3.12

WORKDIR /app
COPY . .
RUN pip install .

CMD ["uvicorn", "orders.main:app", "--host", "0.0.0.0", "--port", "8000"]
